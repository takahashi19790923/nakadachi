{
  "name": "nakadachi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:preview": "node scripts/build.mjs preview",
    "build:production": "node scripts/build.mjs production",
    "preview": "pnpm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "node --experimental-strip-types scripts/check-db.ts",
    "demo:data": "node --experimental-strip-types scripts/demo-data.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "secrets:put": "node scripts/put-secrets.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:integration && pnpm run build && pnpm run check:build-secrets",
    "check:build-secrets": "node scripts/check-secrets.mjs --build",
    "deploy:preview": "pnpm run build:preview && pnpm run check:build-secrets && wrangler deploy",
    "deploy:production": "pnpm run build:production && pnpm run check:build-secrets && wrangler deploy",
    "cron": "node --experimental-strip-types scripts/cron.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@eslint/js": "10.0.1",
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
