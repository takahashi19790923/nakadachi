/**
 * Cloudflare Workers 設定。
 *
 * ここに書いてよいのは「公開されても困らない値」だけ。接続文字列・APIキー・
 * 署名鍵は必ず `wrangler secret put` で入れる（DEPLOYMENT.md の手順を参照）。
 *
 * ★ env ごとに vars を丸ごと書いている理由 ★
 * wrangler の named environment は vars を継承しない。トップレベルにだけ書くと
 * `--env production` で vars が空になり、APP_ORIGIN が undefined のまま動く。
 * 継承を期待して片方だけ書くと、Origin 検証と Turnstile の hostname 照合が
 * まとめて壊れるので、重複を承知で全部書く。
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nakadachi",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-08-13",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// ★トップレベルでも workers.dev を閉じる。★
	// ここは開発用の設定（ENVIRONMENT: development、APP_ORIGIN が localhost）で、
	// routes も無い。`--env` を付けずに build → deploy すると、この設定のまま
	// *.workers.dev に公開される。中身は同じなのに canonicalRedirect が
	// 効かず（development では null を返す）、Turnstile のホスト名照合も
	// 外れる URL が1つ増える。env 側と同じく、既定に頼らず書いておく。
	"workers_dev": false,

	// ★1リクエストが使える CPU 時間の上限。★
	// 既定は30秒。ハングやループを踏んだとき、既定のままだと1リクエストで
	// 30秒ぶんの CPU を焼く。実測は平均 6.2ms/リクエストなので 1000ms でも
	// 160倍の余裕がある。I/O（DB・fetch）の待ち時間は CPU 時間に入らないので、
	// 遅いクエリで打ち切られることはない。
	// limits は継承されるキーなので、env.preview / env.production にも効く。
	"limits": {
		"cpu_ms": 1000
	},

	// ── ローカル開発（wrangler dev / vite dev）─────────────────────────
	// 値の上書きは .dev.vars で行う。アプリのコードを dev と本番で分岐させない。
	"vars": {
		"ENVIRONMENT": "development",
		"APP_ORIGIN": "http://localhost:5273",
		"SESSION_COOKIE_NAME": "nakadachi_session",
		"MAIL_FROM": "なかだち <notice@rewrite-co.com>",
		"EMAIL_REPLY_TO": "support@rewrite-co.com",
		"EXPECTED_CURRENCY": "jpy",
		// ローカルは Cloudflare のテスト用サイトキー（常に成功）。
		// 共有ウィジェットのホスト名に localhost は入っていない。
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"TURNSTILE_EXPECTED_HOSTS": "localhost"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nakadachi-media-dev",
			"preview_bucket_name": "nakadachi-media-dev"
		},
		/*
		 * ★DBの書き出し先。投稿の写真とは別のバケットにする。★
		 * 中身は利用者の投稿・メッセージ・暗号化済みメールアドレス・
		 * 決済記録を含む完全な写し。写真の配信経路や掃除処理が
		 * 絶対に触らない場所へ隔離しておく。
		 * dev では書き出さないので preview のバケットを指しておく。
		 */
		{
			"binding": "BACKUPS",
			"bucket_name": "nakadachi-backups-preview",
			"preview_bucket_name": "nakadachi-backups-preview"
		}
	],

	"env": {
		// ── preview ────────────────────────────────────────────────────
		// Stripe / Resend / Neon / R2 をすべて production と別系統にする。
		"preview": {
			"vars": {
				"ENVIRONMENT": "preview",
				"APP_ORIGIN": "https://nakadachi-preview.rewrite-co.com",
				"SESSION_COOKIE_NAME": "__Host-nakadachi_session",
				"MAIL_FROM": "なかだち(preview) <notice@rewrite-co.com>",
				"EMAIL_REPLY_TO": "support@rewrite-co.com",
				"EXPECTED_CURRENCY": "jpy",
				"TURNSTILE_SITE_KEY": "0x4AAAAAAELgQFNdxUExXAXc",
				"TURNSTILE_EXPECTED_HOSTS": "nakadachi-preview.rewrite-co.com"
			},
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "nakadachi-media-preview"
				},
				{
					"binding": "BACKUPS",
					"bucket_name": "nakadachi-backups-preview"
				}
			],
			"routes": [
				{
					"pattern": "nakadachi-preview.rewrite-co.com",
					"custom_domain": true
				}
			],
			/*
			 * ★定期処理。env ごとに書く（vars と同じく継承されない）。★
			 * 中身は workers/app.ts の scheduled と app/server/cron.server.ts。
			 * 時刻は UTC。"20 19 * * *" は日本時間の 04:20。
			 *
			 * ここが無いと、退会の30日後の削除も発信者情報の183日での削除も
			 * 一切走らない。2026-08-16 まで実際にその状態だった。
			 */
			"triggers": {
				"crons": ["0 * * * *", "20 19 * * *"]
			},
			/*
			 * ★Hyperdrive 経由で Neon へ繋ぐ。★
			 *
			 * 2026-08-17 22:50 JST 頃から、Cloudflare（NRT）→ Neon（ap-southeast-1）
			 * の問い合わせが 2〜40秒に振れる時間帯が2時間以上続いた。手元の PC や
			 * Vercel からは 70〜250ms で返り、HTTP でも WebSocket でも同じだったので
			 * Neon 本体ではなく Cloudflare の出口と AWS シンガポールの間の経路。
			 * Hyperdrive は DB の近くの Cloudflare 拠点から接続を張りっぱなしにして
			 * 使い回すので、リクエストごとに新しい接続を張らずに済む。
			 * 平常時も接続の確立ぶんが減る。
			 *
			 * ID は `wrangler hyperdrive create nakadachi-preview` の出力。
			 * 接続文字列は Neon の「接続プール無し」のホスト（-pooler を外したもの）。
			 * binding が無い環境（ローカル・テスト）は従来どおり Neon の
			 * serverless ドライバで直接繋ぐ（app/server/db.server.ts）。
			 */
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "05f672e8d21847eeaa0057af574d96be"
				}
			],
			// ★workers.dev を明示的に閉じる。★
			// 開いていると同じ内容が *.workers.dev でも見え、こちらは
			// TURNSTILE_EXPECTED_HOSTS に一致しないので認証だけが壊れる。
			// 「サイトは見えるのにログインできないURL」が1つ増える形になる。
			// 既定でも routes があれば閉じるが、既定に頼らず書いておく。
			"workers_dev": false
		},

		// ── production ─────────────────────────────────────────────────
		"production": {
			"vars": {
				"ENVIRONMENT": "production",
				"APP_ORIGIN": "https://nakadachi.rewrite-co.com",
				"SESSION_COOKIE_NAME": "__Host-nakadachi_session",
				"MAIL_FROM": "なかだち <notice@rewrite-co.com>",
				"EMAIL_REPLY_TO": "support@rewrite-co.com",
				"EXPECTED_CURRENCY": "jpy",
				// 共有ウィジェット rewrite-co-common。新規に作らない（Free 上限20）。
				"TURNSTILE_SITE_KEY": "0x4AAAAAAELgQFNdxUExXAXc",
				// ★完全一致で照合する。1つの鍵を全サービスで共有しているため、
				//   ここが空だと他サービス向けに解かれたトークンがそのまま通る。
				"TURNSTILE_EXPECTED_HOSTS": "nakadachi.rewrite-co.com"
			},
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "nakadachi-media"
				},
				{
					"binding": "BACKUPS",
					"bucket_name": "nakadachi-backups"
				}
			],
			"routes": [
				{
					"pattern": "nakadachi.rewrite-co.com",
					"custom_domain": true
				}
			],
			// preview と同じ。継承されないので、こちらにも必ず書く。
			"triggers": {
				"crons": ["0 * * * *", "20 19 * * *"]
			},
			/*
			 * ★本番の DB は Supabase（東京 ap-northeast-1）。2026-08-18 に Neon（シンガポール）から移した。★
			 * ID は `wrangler hyperdrive create nakadachi-production-tokyo --caching-disabled=true`。
			 * 接続先は Supabase の Direct connection（db.<ref>.supabase.co:5432、プーラーではない）、
			 * ロールは DDL 無しの nakadachi_app_production（scripts/create-app-role.ts）。
			 * ★キャッシュは切ってある。★ 投稿した直後の一覧に最大60秒古い結果が出るのを避けるため。
			 *
			 * 退避路: 移行元の Neon を指す設定 bc7ebd4ecfdc4b70a4860fb2338418e2 はまだ残してある。
			 * ID を戻してデプロイすれば Neon に戻る（ただし移行後の書き込みは戻らない）。
			 * 数日様子を見て Neon のプロジェクトごと消す（DEPLOYMENT.md「Hyperdrive」）。
			 */
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "2a9ea1265a9943fe9f2ff27c26c8dbd1"
				}
			],
			// preview と同じ理由で明示的に閉じる。
			"workers_dev": false
		}
	}
}
