# ─────────────────────────────────────────────────────────────────
# ローカル開発用の環境変数（Node 側のツールが読む）
#
#   cp .env.example .env
#
# ★このファイルに本物の値を書かないこと。★
# .env は .gitignore 済みだが、.env.example は追跡対象。ここへ実値を
# 書くと、その瞬間に Git 履歴へ入る。ダミーは「本物と見間違えない形」に
# してあるので、形式を真似て置き換えること。
#
# アプリ本体（Workers）が読む値は .dev.vars / wrangler secret 側にある。
# こちらは drizzle-kit・マイグレーション・seed・定期処理など Node 実行のもの。
# ─────────────────────────────────────────────────────────────────

# ── Neon の接続文字列 ─────────────────────────────────────────────
#
# Neon の接続文字列は、★データベース名以外はすべて同じ★。
# コンソールの「Connect」から1つコピーし、末尾の DB 名だけ差し替えれば
# 3つとも作れる。
#
# ★必ず pooled を使う（ホスト名に -pooler が入っているもの）。★
# Workers は接続数が読めないため、直接接続だと上限に当たる。
#
# ★環境を取り違えないよう、3つを別々の変数で持つ。★
# コマンドは `pnpm run db:migrate` / `-- preview` / `-- production` で
# 明示的に選ぶ。スクリプト側で「変数名と接続先のDB名が一致するか」も
# 検査するので、貼り間違えれば必ず落ちる。

DATABASE_URL_DEV="postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE-ME-ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/nakadachi_dev?sslmode=require&channel_binding=require"
DATABASE_URL_PREVIEW="postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE-ME-ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/nakadachi_preview?sslmode=require&channel_binding=require"
# ★本番は Supabase（東京）。★ 所有者ロール postgres の Direct connection（5432、プーラーではない）。
# sslmode は no-verify（Supabase の CA は素の pg で検証できない。require にすると落ちる）。
DATABASE_URL_PRODUCTION="postgresql://postgres:REPLACE_ME_PASSWORD@db.REPLACE_ME_PROJECT_REF.supabase.co:5432/postgres?sslmode=no-verify"
# 本番のアプリ用ロール（DDL 無し）。pnpm run db:create-app-role が作って書き込む。Hyperdrive の接続先。
DATABASE_URL_APP_PRODUCTION="postgresql://nakadachi_app_production:REPLACE_ME_PASSWORD@db.REPLACE_ME_PROJECT_REF.supabase.co:5432/postgres"
# 移行元の Neon（退避路。数日様子を見て消す）
# DATABASE_URL_PRODUCTION_NEON="postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE-ME-ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/nakadachi?sslmode=require&channel_binding=require"

# ★復旧の練習用（drill）。★ 使い捨ての空の Supabase プロジェクトを指すこと。
# 手順は OPERATIONS.md「復旧の練習」。練習が終わったらプロジェクトごと削除し、
# ここもコメントに戻す。
#
# ★本番の ref を貼ると実行を拒みます。★ 流し込みは --replace で対象の表を
# 全部空にするので、本番を向いていたら本番が消えます（scripts/db.ts で止めています）。
# ★dev / preview も使えません。★ 本番の個人情報が検証環境へ移ります。
# DATABASE_URL_DRILL="postgresql://postgres:REPLACE_ME_PASSWORD@db.REPLACE_ME_DRILL_REF.supabase.co:5432/postgres?sslmode=no-verify"

# drizzle-kit（db:generate / db:studio）が読む値。dev を指しておく。
DATABASE_URL="postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE-ME-ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/nakadachi_dev?sslmode=require&channel_binding=require"

# ── テスト ────────────────────────────────────────────────────────
# 統合テスト用。★本番と同じデータベースを指さないこと★
# 統合テストは全テーブルを TRUNCATE する。既定では PGlite をその場で
# 立てるので未設定でよい。実 Postgres に当てたいときだけ設定する。
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/nakadachi_test"

# ── メール送信の鍵（create-admin で使う）──────────────────────────
# ★その環境へ投入したものと同じ値にすること。★ 違うと索引が一致せず、
# 作った管理者でログインできない。
# EMAIL_ENCRYPTION_KEY=""
# EMAIL_INDEX_KEY=""

# ── E2E ───────────────────────────────────────────────────────────
# 未設定ならローカルの本番ビルドに当たる。preview に当てるときだけ設定する。
# E2E_BASE_URL="https://nakadachi-preview.rewrite-co.com"
